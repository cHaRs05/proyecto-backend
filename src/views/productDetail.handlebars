<div style="max-width: 800px; margin: 40px auto; padding: 20px; background: white; border-radius: 15px; box-shadow: 0 4px 20px rgba(0,0,0,0.1); display: flex; gap: 30px; align-items: center;">
    
    <div style="flex: 1;">
        <div style="width: 100%; height: 300px; background: #f8f9fa; border-radius: 10px; display: flex; align-items: center; justify-content: center; color: #ccc; font-size: 50px;">
            🛒
        </div>
    </div>

    <div style="flex: 1.2;">
        <a href="/products" style="text-decoration: none; color: #3498db; font-weight: bold;">« Volver a la tienda</a>
        <h1 style="color: #2c3e50; margin: 15px 0;">{{product.title}}</h1>
        <p style="background: #ecf0f1; display: inline-block; padding: 5px 12px; border-radius: 20px; font-size: 0.85em; color: #7f8c8d; font-weight: bold;">
            Categoría: {{product.category}}
        </p>
        
        <p style="color: #555; line-height: 1.6; margin: 20px 0;">{{product.description}}</p>
        
        <h2 style="color: #27ae60; font-size: 2em; margin-bottom: 25px;">${{product.price}}</h2>

        <button onclick="addToCart('{{product._id}}')" style="background: #2c3e50; color: white; border: none; padding: 15px 25px; border-radius: 8px; cursor: pointer; font-weight: bold; width: 100%; font-size: 1.1em;">
            🚀 Agregar al Carrito
        </button>
    </div>
</div>

<script>
    const MI_CARRITO_ID = "69c61609e967c8689ccfd1c5"; //

    async function addToCart(productId) {
        try {
            const response = await fetch(`/api/carts/${MI_CARRITO_ID}/product/${productId}`, { method: 'POST' });
            const result = await response.json();
            if (result.status === 'success') alert("✅ ¡Hardware añadido al carrito!");
        } catch (error) {
            console.error("Error:", error);
        }
    }
</script>